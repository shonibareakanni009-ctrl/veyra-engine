{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Veyra Engine release manifest",
  "description": "Authenticated metadata for one Windows x64 Veyra Engine release. This schema validates structure only; updater code must verify the Ed25519 signature and package digest.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "product",
    "version",
    "channel",
    "platform",
    "architecture",
    "minimumUpdaterVersion",
    "package",
    "signature"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "product": {
      "const": "veyra-engine"
    },
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(?:-[0-9A-Za-z.-]+)?$"
    },
    "channel": {
      "enum": [
        "stable",
        "beta",
        "developer"
      ]
    },
    "platform": {
      "const": "windows"
    },
    "architecture": {
      "const": "x64"
    },
    "minimumUpdaterVersion": {
      "type": "string",
      "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)$"
    },
    "releaseNotesUrl": {
      "type": "string",
      "format": "uri",
      "pattern": "^https://"
    },
    "package": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "url",
        "sizeBytes",
        "sha256"
      ],
      "properties": {
        "url": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://"
        },
        "sizeBytes": {
          "type": "integer",
          "minimum": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[A-Fa-f0-9]{64}$"
        }
      }
    },
    "signature": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "algorithm",
        "keyId",
        "value"
      ],
      "properties": {
        "algorithm": {
          "const": "Ed25519"
        },
        "keyId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._-]{1,64}$"
        },
        "value": {
          "type": "string",
          "contentEncoding": "base64",
          "minLength": 80,
          "maxLength": 100
        }
      }
    }
  }
}
